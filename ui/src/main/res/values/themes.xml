<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VocalRemover.Launcher" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">#19263B</item>
        <item name="android:statusBarColor">#19263B</item>
        <item name="android:navigationBarColor">#19263B</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Used only by MediaProjectionConsentActivity: a "trampoline" Activity
         (ComponentActivity, no Compose UI of its own) that only has to show
         the system MediaProjection consent dialog on top of the floating
         bubble. ComponentActivity does not require a theme descending from
         AppCompat: it starts from the system theme for transparency. -->
    <style name="Theme.VocalRemover.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
