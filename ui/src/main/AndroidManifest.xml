<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Floating widget to manage recording on top of other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.VocalRemover"
        android:supportsRtl="true">

        <activity
            android:name="com.stef.vocalremover.ui.MainActivity"
            android:theme="@style/Theme.VocalRemover.Launcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Empty taskAffinity: started by the bubble with FLAG_ACTIVITY_NEW_TASK, it opens a task
             of its own instead of bringing the app's hidden task to the foreground
             (moveTaskToBack) and leaving it visible when it closes. -->
        <activity
            android:name="com.stef.vocalremover.ui.overlay.MediaProjectionConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.VocalRemover.Transparent" />

        <service
            android:name="com.stef.vocalremover.ui.overlay.BubbleOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:targetApi="34">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_recording_control_widget" />
        </service>

    </application>
</manifest>
