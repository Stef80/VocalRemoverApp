<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lettura file audio dallo storage -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Android 16 (API 36): notifica per riproduzione in foreground -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Impedisce la sospensione CPU durante l'elaborazione -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Cattura audio di sistema da un'altra app tramite MediaProjection -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Visibilità pacchetti richiesta da Android 11+ per poter risolvere
         l'UID delle app sorgente candidate tramite PackageManager.getApplicationInfo() -->
    <queries>
        <package android:name="com.android.chrome" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.spotify.music" />
        <package android:name="com.opera.browser" />
        <package android:name="com.heytap.music" />
        <package android:name="com.coloros.video" />
        <package android:name="com.amazon.mp3" />
    </queries>

    <application>

        <!-- Schermata XML precedente: il launcher è ora la MainActivity Compose di :ui -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- Gestione file audio condivisi via altre app -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".capture.SystemAudioCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>
</manifest>
